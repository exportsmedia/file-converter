{
  "name": "file-converter",
  "version": "1.0.0",
  "description": "Convert CBR/RAR archives to ZIP or CBZ",
  "author": "Michael Markoski",
  "license": "MIT",
  "homepage": "https://github.com/exportsmedia/file-converter",
  "repository": {
    "type": "git",
    "url": "https://github.com/exportsmedia/file-converter.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.exportsmedia.file-converter",
    "productName": "File Converter",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
